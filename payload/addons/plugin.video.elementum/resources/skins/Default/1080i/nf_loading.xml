<?xml version="1.0" encoding="UTF-8"?>
<!-- claude 20261115: Netflix-style minimal loading screen for Elementum (replaces the buffering progress dialog) -->
<window>
    <zorder>3</zorder>
    <animation effect="fade" start="0" end="100" time="350">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="300">WindowClose</animation>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF000000">common/white.png</texture>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <aspectratio>scale</aspectratio>
            <texture background="true">$INFO[Window.Property(fanart)]</texture>
            <animation effect="zoom" start="100" end="106" center="auto" time="20000" tween="linear">WindowOpen</animation>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="8C000000">common/white.png</texture>
        </control>
        <!-- logo, or title when there is no logo -->
        <control type="image">
            <centerleft>50%</centerleft><centertop>45%</centertop>
            <width>760</width><height>300</height>
            <aspectratio>keep</aspectratio>
            <texture background="true">$INFO[Window.Property(clearlogo)]</texture>
            <visible>!String.IsEmpty(Window.Property(clearlogo))</visible>
        </control>
        <control type="label">
            <centerleft>50%</centerleft><top>556</top>
            <width>1400</width><height>90</height>
            <align>center</align><aligny>center</aligny>
            <font>font_head_bold</font>
            <textcolor>FFFFFFFF</textcolor>
            <label>$INFO[Window.Property(title)]</label>
            <visible>String.IsEmpty(Window.Property(clearlogo))</visible>
        </control>
        <control type="label">
            <centerleft>50%</centerleft><top>656</top>
            <width>800</width><height>40</height>
            <align>center</align>
            <font>font_mini</font>
            <textcolor>B3FFFFFF</textcolor>
            <label>$INFO[Window.Property(year)]</label>
        </control>
        <!-- thin red progress -->
        <control type="group">
            <centerleft>50%</centerleft><top>712</top>
            <width>420</width><height>4</height>
            <control type="image">
                <width>420</width><height>4</height>
                <texture colordiffuse="33FFFFFF">common/white.png</texture>
            </control>
            <control type="progress" id="20">
                <width>420</width><height>4</height>
                <texturebg colordiffuse="00FFFFFF">common/white.png</texturebg>
                <lefttexture /><righttexture /><overlaytexture />
                <midtexture colordiffuse="FFE50914">common/white.png</midtexture>
            </control>
        </control>
        <control type="label">
            <centerleft>50%</centerleft><top>732</top>
            <width>600</width><height>40</height>
            <align>center</align>
            <font>font_mini</font>
            <textcolor>99FFFFFF</textcolor>
            <label>$INFO[Window.Property(status)]</label>
        </control>
    </controls>
</window>
