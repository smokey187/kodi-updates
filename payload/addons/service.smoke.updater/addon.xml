<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.smoke.updater" name="Smoke Box Updater" version="1.4.0" provider-name="smoke">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.service" library="service.py" start="startup"/>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Automatic updates for smoke's CoreELEC boxes</summary>
        <description lang="en_GB">Installs updates of the box customizations at startup or when the box is idle, with a progress screen, automatic rollback and a report to the owner.</description>
        <platform>all</platform>
        <license>MIT</license>
    </extension>
</addon>
