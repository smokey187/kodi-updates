<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.studio.logo.fallback"
       name="Studio Logo Fallback"
       version="1.0.0"
       provider-name="Local">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">Studio logo name fallback</summary>
        <description lang="en">Uses the full studio name first, then the first word if the logo is missing.</description>
        <platform>all</platform>
    </extension>
</addon>
