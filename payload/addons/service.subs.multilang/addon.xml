<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.subs.multilang" name="Multi-language subtitles for Elementum" version="1.0.2" provider-name="claude">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="service.subtitles.a4ksubtitles"/>
        <import addon="script.module.requests"/>
        <import addon="vfs.libarchive" optional="true"/>
    </requires>
    <extension point="xbmc.python.script" library="more.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" start="login"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Auto-downloads the best-synced subtitles (3 per language) when Elementum plays</summary>
        <platform>all</platform>
    </extension>
</addon>
