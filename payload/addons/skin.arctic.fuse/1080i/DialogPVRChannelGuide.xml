<?xml version="1.0" encoding="UTF-8"?>
<!-- claude 20261115: side panel with today's schedule of the current channel. Original: DialogPVRChannelGuide.xml.bak-20261115-live -->
<window>
    <defaultcontrol always="true">11</defaultcontrol>
    <onload>CancelAlarm(osd_timeout,true)</onload>
    <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="180">WindowClose</animation>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="59000000">common/white.png</texture>
        </control>
        <control type="group">
            <right>0</right>
            <top>0</top>
            <width>800</width>
            <height>1080</height>
            <animation effect="slide" start="120,0" end="0,0" time="260" tween="cubic" easing="out">WindowOpen</animation>
            <animation effect="slide" start="0,0" end="120,0" time="200" tween="cubic" easing="in">WindowClose</animation>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>800</width>
                <height>1080</height>
                <texture colordiffuse="F00E0E10">common/white.png</texture>
            </control>
            <control type="image">
                <right>60</right>
                <top>44</top>
                <width>150</width>
                <height>96</height>
                <aspectratio aligny="top">keep</aspectratio>
                <texture background="true">$INFO[Player.Icon]</texture>
            </control>
            <control type="label">
                <left>50</left>
                <right>236</right>
                <top>44</top>
                <height>60</height>
                <align>right</align>
                <font>font_main_black</font>
                <textcolor>FFFFFFFF</textcolor>
                <label>לוח שידורים</label>
            </control>
            <control type="label">
                <left>50</left>
                <right>236</right>
                <top>100</top>
                <height>40</height>
                <align>right</align>
                <font>font_mini</font>
                <textcolor>99FFFFFF</textcolor>
                <label>$INFO[VideoPlayer.ChannelName]</label>
            </control>
            <control type="list" id="11">
                <left>24</left>
                <top>170</top>
                <width>752</width>
                <height>616</height>
                <scrolltime tween="cubic" easing="out">220</scrolltime>
                <itemlayout height="88">
                    <control type="label">
                        <left>26</left>
                        <top>0</top>
                        <width>140</width>
                        <height>88</height>
                        <aligny>center</aligny>
                        <font>font_main_bold</font>
                        <textcolor>80FFFFFF</textcolor>
                        <label>$INFO[ListItem.StartTime]</label>
                    </control>
                    <control type="label">
                        <left>170</left>
                        <right>36</right>
                        <height>88</height>
                        <align>right</align>
                        <aligny>center</aligny>
                        <font>font_main</font>
                        <textcolor>B3FFFFFF</textcolor>
                        <label>$INFO[ListItem.Title]</label>
                    </control>
                    <control type="image">
                        <left>26</left>
                        <top>78</top>
                        <width>700</width>
                        <height>4</height>
                        <texture colordiffuse="33FFFFFF">common/white.png</texture>
                        <visible>Integer.IsGreater(ListItem.Progress,0) + Integer.IsLess(ListItem.Progress,100)</visible>
                    </control>
                    <control type="progress">
                        <left>26</left>
                        <top>78</top>
                        <width>700</width>
                        <height>4</height>
                        <texturebg colordiffuse="00FFFFFF">common/white.png</texturebg>
                        <lefttexture />
                        <righttexture />
                        <overlaytexture />
                        <midtexture colordiffuse="FFE50914">common/white.png</midtexture>
                        <info>ListItem.Progress</info>
                        <visible>Integer.IsGreater(ListItem.Progress,0) + Integer.IsLess(ListItem.Progress,100)</visible>
                    </control>
                </itemlayout>
                <focusedlayout height="88">
                    <control type="image">
                        <left>0</left>
                        <top>2</top>
                        <width>752</width>
                        <height>84</height>
                        <texture colordiffuse="2EFFFFFF" border="18">common/box.png</texture>
                        <visible>Control.HasFocus(11)</visible>
                    </control>
                    <control type="image">
                        <right>0</right>
                        <top>20</top>
                        <width>6</width>
                        <height>48</height>
                        <texture colordiffuse="FFE50914">common/white.png</texture>
                        <visible>Control.HasFocus(11)</visible>
                    </control>
                    <control type="label">
                        <left>26</left>
                        <top>0</top>
                        <width>140</width>
                        <height>88</height>
                        <aligny>center</aligny>
                        <font>font_main_bold</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.StartTime]</label>
                    </control>
                    <control type="label">
                        <left>170</left>
                        <right>36</right>
                        <height>88</height>
                        <align>right</align>
                        <aligny>center</aligny>
                        <font>font_main_bold</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <scroll>true</scroll>
                        <label>$INFO[ListItem.Title]</label>
                    </control>
                    <control type="image">
                        <left>26</left>
                        <top>78</top>
                        <width>700</width>
                        <height>4</height>
                        <texture colordiffuse="33FFFFFF">common/white.png</texture>
                        <visible>Integer.IsGreater(ListItem.Progress,0) + Integer.IsLess(ListItem.Progress,100)</visible>
                    </control>
                    <control type="progress">
                        <left>26</left>
                        <top>78</top>
                        <width>700</width>
                        <height>4</height>
                        <texturebg colordiffuse="00FFFFFF">common/white.png</texturebg>
                        <lefttexture />
                        <righttexture />
                        <overlaytexture />
                        <midtexture colordiffuse="FFE50914">common/white.png</midtexture>
                        <info>ListItem.Progress</info>
                        <visible>Integer.IsGreater(ListItem.Progress,0) + Integer.IsLess(ListItem.Progress,100)</visible>
                    </control>
                </focusedlayout>
            </control>
            <!-- details of the focused programme -->
            <control type="image">
                <left>50</left>
                <top>810</top>
                <width>700</width>
                <height>2</height>
                <texture colordiffuse="26FFFFFF">common/white.png</texture>
            </control>
            <control type="label">
                <left>50</left>
                <right>60</right>
                <top>826</top>
                <height>40</height>
                <align>right</align>
                <font>font_mini_bold</font>
                <textcolor>FFFFFFFF</textcolor>
                <label>$INFO[Container(11).ListItem.StartTime]$INFO[Container(11).ListItem.EndTime, – ,]</label>
            </control>
            <control type="textbox">
                <left>50</left>
                <right>60</right>
                <top>872</top>
                <height>170</height>
                <align>right</align>
                <font>font_mini</font>
                <textcolor>B3FFFFFF</textcolor>
                <label>$INFO[Container(11).ListItem.Plot]</label>
                <autoscroll delay="4000" time="2000" repeat="6000">true</autoscroll>
            </control>
        </control>
    </controls>
</window>
