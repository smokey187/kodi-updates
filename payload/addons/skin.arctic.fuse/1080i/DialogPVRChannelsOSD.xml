<?xml version="1.0" encoding="UTF-8"?>
<!-- claude 20261115: side panel channel list (live TV). Original: DialogPVRChannelsOSD.xml.bak-20261115-live -->
<window>
    <defaultcontrol always="true">11</defaultcontrol>
    <onload>CancelAlarm(osd_timeout,true)</onload>
    <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="180">WindowClose</animation>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="59000000">common/white.png</texture>
        </control>
        <control type="group">
            <right>0</right>
            <top>0</top>
            <width>800</width>
            <height>1080</height>
            <animation effect="slide" start="120,0" end="0,0" time="260" tween="cubic" easing="out">WindowOpen</animation>
            <animation effect="slide" start="0,0" end="120,0" time="200" tween="cubic" easing="in">WindowClose</animation>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>800</width>
                <height>1080</height>
                <texture colordiffuse="F00E0E10">common/white.png</texture>
            </control>
            <control type="label">
                <right>60</right>
                <top>48</top>
                <width>500</width>
                <height>64</height>
                <align>right</align>
                <font>font_main_black</font>
                <textcolor>FFFFFFFF</textcolor>
                <label>ערוצים</label>
            </control>
            <control type="label">
                <left>50</left>
                <top>48</top>
                <width>360</width>
                <height>64</height>
                <font>font_mini</font>
                <textcolor>80FFFFFF</textcolor>
                <label>$INFO[Container(11).NumItems,, channels]</label>
            </control>
            <control type="list" id="11">
                <left>24</left>
                <top>140</top>
                <width>752</width>
                <height>880</height>
                <scrolltime tween="cubic" easing="out">220</scrolltime>
                <itemlayout height="176">
                    <control type="image">
                        <right>36</right>
                        <top>22</top>
                        <width>180</width>
                        <height>116</height>
                        <aspectratio>keep</aspectratio>
                        <texture background="true">$INFO[ListItem.Icon]</texture>
                    </control>
                    <control type="label">
                        <left>26</left>
                        <right>240</right>
                        <top>18</top>
                        <height>48</height>
                        <align>right</align>
                        <font>font_main_bold</font>
                        <textcolor>E6FFFFFF</textcolor>
                        <label>$INFO[ListItem.ChannelName]</label>
                    </control>
                    <control type="label">
                        <left>26</left>
                        <top>18</top>
                        <width>120</width>
                        <height>48</height>
                        <font>font_main_bold</font>
                        <textcolor>66FFFFFF</textcolor>
                        <label>$INFO[ListItem.ChannelNumberLabel]</label>
                    </control>
                    <control type="label">
                        <left>26</left>
                        <right>240</right>
                        <top>66</top>
                        <height>44</height>
                        <align>right</align>
                        <font>font_mini</font>
                        <textcolor>8CFFFFFF</textcolor>
                        <label>$INFO[ListItem.Title]</label>
                    </control>
                    <control type="image">
                        <left>26</left>
                        <top>128</top>
                        <width>486</width>
                        <height>5</height>
                        <texture colordiffuse="33FFFFFF">common/white.png</texture>
                        <visible>!String.IsEmpty(ListItem.Title)</visible>
                    </control>
                    <control type="progress">
                        <left>26</left>
                        <top>128</top>
                        <width>486</width>
                        <height>5</height>
                        <texturebg colordiffuse="00FFFFFF">common/white.png</texturebg>
                        <lefttexture />
                        <righttexture />
                        <overlaytexture />
                        <midtexture colordiffuse="CCE50914">common/white.png</midtexture>
                        <info>ListItem.Progress</info>
                        <visible>!String.IsEmpty(ListItem.Title)</visible>
                    </control>
                </itemlayout>
                <focusedlayout height="176">
                    <control type="image">
                        <left>0</left>
                        <top>4</top>
                        <width>752</width>
                        <height>164</height>
                        <texture colordiffuse="2EFFFFFF" border="18">common/box.png</texture>
                        <visible>Control.HasFocus(11)</visible>
                    </control>
                    <control type="image">
                        <right>0</right>
                        <top>40</top>
                        <width>6</width>
                        <height>90</height>
                        <texture colordiffuse="FFE50914">common/white.png</texture>
                        <visible>Control.HasFocus(11)</visible>
                    </control>
                    <control type="image">
                        <right>36</right>
                        <top>22</top>
                        <width>180</width>
                        <height>116</height>
                        <aspectratio>keep</aspectratio>
                        <texture background="true">$INFO[ListItem.Icon]</texture>
                    </control>
                    <control type="label">
                        <left>26</left>
                        <right>240</right>
                        <top>18</top>
                        <height>48</height>
                        <align>right</align>
                        <font>font_main_black</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.ChannelName]</label>
                    </control>
                    <control type="label">
                        <left>26</left>
                        <top>18</top>
                        <width>120</width>
                        <height>48</height>
                        <font>font_main_bold</font>
                        <textcolor>99FFFFFF</textcolor>
                        <label>$INFO[ListItem.ChannelNumberLabel]</label>
                    </control>
                    <control type="label">
                        <left>26</left>
                        <right>240</right>
                        <top>66</top>
                        <height>44</height>
                        <align>right</align>
                        <font>font_mini</font>
                        <textcolor>E6FFFFFF</textcolor>
                        <scroll>true</scroll>
                        <label>$INFO[ListItem.Title]</label>
                    </control>
                    <control type="image">
                        <left>26</left>
                        <top>128</top>
                        <width>486</width>
                        <height>5</height>
                        <texture colordiffuse="33FFFFFF">common/white.png</texture>
                        <visible>!String.IsEmpty(ListItem.Title)</visible>
                    </control>
                    <control type="progress">
                        <left>26</left>
                        <top>128</top>
                        <width>486</width>
                        <height>5</height>
                        <texturebg colordiffuse="00FFFFFF">common/white.png</texturebg>
                        <lefttexture />
                        <righttexture />
                        <overlaytexture />
                        <midtexture colordiffuse="FFE50914">common/white.png</midtexture>
                        <info>ListItem.Progress</info>
                        <visible>!String.IsEmpty(ListItem.Title)</visible>
                    </control>
                    <control type="label">
                        <left>26</left>
                        <right>240</right>
                        <top>136</top>
                        <height>36</height>
                        <align>right</align>
                        <font>font_tiny</font>
                        <textcolor>80FFFFFF</textcolor>
                        <label>$INFO[ListItem.NextStartTime,הבא ,  ·  ]$INFO[ListItem.NextTitle]</label>
                        <visible>Control.HasFocus(11)</visible>
                    </control>
                </focusedlayout>
            </control>
        </control>
    </controls>
</window>
