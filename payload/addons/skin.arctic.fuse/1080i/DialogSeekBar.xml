<?xml version="1.0" encoding="UTF-8"?>
<window>
    <zorder>0</zorder>
    <visible>!Player.HasGame</visible>
    <visible>!Window.IsActive(DialogPlayerProcessInfo.xml)</visible>
    <visible>Window.IsActive(VideoFullScreen.xml) | Window.IsActive(MusicVisualisation.xml)</visible>
    <visible>Window.IsActive(videoosd) | Window.IsActive(musicosd) | Player.Caching | Player.ShowInfo | Player.Seeking | Player.HasPerformedSeek(2) | [Player.Paused + [!System.IdleTime(3) | !Skin.HasSetting(OSD.AutoHideOnPause)]] | Player.Forwarding | Player.Rewinding | Window.IsActive(DialogFullScreenInfo.xml) | !String.IsEmpty(Player.SeekNumeric) | !String.IsEmpty(PVR.ChannelNumberInput) | Window.IsVisible(script-cu-lrclyrics-main.xml) | $EXP[Exp_OSD_ExpandInfo]</visible>
    <visible>!Window.IsVisible(DialogSlider.xml)</visible>
    <onload condition="Player.Paused + !String.IsEmpty(Window(Home).Property(OSDExtendedInfo))">PlayerControl(Play)</onload>
    <onload condition="Player.Paused + !String.IsEmpty(Window(Home).Property(OSDExtendedInfo))">ClearProperty(OSDExtendedInfo,Home)</onload>
    <controls>

        <control type="image">
            <texture colordiffuse="7f000000">common/white.png</texture>
            <visible>[!String.IsEmpty(Window(Home).Property(OSDArtistDetails)) + !Window.IsVisible(1142)] | Window.IsVisible(script-cu-lrclyrics-main.xml)</visible>
            <include>Animation_OSD_Fullscreen_Change</include>
        </control>

        <control type="image">
            <visible>!Player.HasVideo</visible>
            <texture colordiffuse="panel_bg_70">background/combined_flixart.png</texture>
            <include>Animation_OSD_Fullscreen_Change</include>
        </control>


        <!-- live TV zap banner (claude 20261115) -->
        <control type="group">
            <visible>VideoPlayer.Content(livetv) + !Window.IsActive(videoosd) + !Window.IsActive(pvrosdchannels) + !Window.IsActive(pvrosdguide)</visible>
            <animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="220">WindowClose</animation>
            <include content="NF_LiveCard">
                <param name="bottom">96</param>
            </include>
        </control>

        <!-- claude 20261115: Netflix-style "You're watching" panel while paused -->
        <control type="group">
            <visible>Player.Paused + Player.HasVideo + !VideoPlayer.Content(livetv)</visible>
            <animation effect="fade" start="0" end="100" time="400" delay="150">Visible</animation>
            <animation effect="fade" start="100" end="0" time="200">Hidden</animation>
            <control type="image">
                <left>0</left><top>0</top><width>1920</width><height>1080</height>
                <texture colordiffuse="8C000000">common/white.png</texture>
            </control>
            <control type="image">
                <left>0</left><top>0</top><width>1400</width><height>1080</height>
                <texture colordiffuse="CC000000">common/dim-side-full.png</texture>
            </control>
            <control type="group">
                <left>120</left><centertop>46%</centertop>
                <width>1500</width><height>420</height>
                <control type="image">
                    <left>0</left><top>0</top><width>280</width><height>420</height>
                    <aspectratio>scale</aspectratio>
                    <texture background="true" fallback="DefaultVideo.png">$VAR[NF_Pause_Poster]</texture>
                </control>
                <control type="label">
                    <left>330</left><top>0</top><width>1000</width><height>40</height>
                    <font>font_mini</font>
                    <textcolor>99FFFFFF</textcolor>
                    <label>You're watching</label>
                </control>
                <control type="image">
                    <left>330</left><top>48</top><width>620</width><height>140</height>
                    <aspectratio align="left" aligny="center">keep</aspectratio>
                    <texture background="true">$VAR[NF_Pause_Logo]</texture>
                    <visible>!String.IsEmpty(Player.Art(clearlogo)) | !String.IsEmpty(Player.Art(tvshow.clearlogo)) | !String.IsEmpty(Window(Home).Property(NF.PauseLogo))</visible>
                </control>
                <control type="label">
                    <left>330</left><top>48</top><width>1100</width><height>140</height>
                    <aligny>center</aligny>
                    <font>font_head_bold</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$VAR[NF_Pause_Title]</label>
                    <visible>String.IsEmpty(Player.Art(clearlogo)) + String.IsEmpty(Player.Art(tvshow.clearlogo)) + String.IsEmpty(Window(Home).Property(NF.PauseLogo))</visible>
                </control>
                <control type="label">
                    <left>330</left><top>200</top><width>1100</width><height>44</height>
                    <font>font_mini_bold</font>
                    <textcolor>E6FFFFFF</textcolor>
                    <label>$VAR[NF_Pause_Sub]</label>
                </control>
                <control type="textbox">
                    <left>330</left><top>256</top><width>1000</width><height>164</height>
                    <font>font_mini</font>
                    <textcolor>CCFFFFFF</textcolor>
                    <label>$INFO[VideoPlayer.Plot]</label>
                </control>
            </control>
            <control type="label">
                <right>96</right><top>70</top><width>400</width><height>50</height>
                <align>right</align>
                <font>font_main_bold</font>
                <textcolor>B3FFFFFF</textcolor>
                <label>Paused</label>
                <visible>!Window.IsActive(videoosd)</visible>
            </control>
        </control>
        <!-- NF minimal seek bar (video, OSD closed) - same geometry as VideoOSD -->
        <control type="group">
            <visible>Player.HasVideo + !Window.IsActive(videoosd) + !VideoPlayer.Content(livetv)</visible>
            <animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
            <control type="image">
                <left>0</left><bottom>0</bottom><width>1920</width><height>320</height>
                <texture colordiffuse="E6000000">common/dim-thick-bottom-full.png</texture>
            </control>
            <control type="label">
                <left>96</left><bottom>220</bottom><width>1484</width><height>48</height>
                <align>center</align><font>font_main_black</font><textcolor>FFFFFFFF</textcolor>
                <label>$INFO[Player.SeekOffset]</label>
                <visible>Player.Seeking | Player.HasPerformedSeek(1)</visible>
            </control>
            <control type="image"><left>96</left><bottom>179</bottom><width>1484</width><height>10</height><texture colordiffuse="4DFFFFFF" border="4">common/box.png</texture></control>
            <control type="progress"><left>96</left><bottom>179</bottom><width>1484</width><height>10</height><texturebg colordiffuse="00FFFFFF">common/white.png</texturebg><lefttexture /><righttexture /><overlaytexture /><midtexture colordiffuse="4DFFFFFF">common/white.png</midtexture><info>Player.ProgressCache</info></control>
            <control type="progress"><left>96</left><bottom>179</bottom><width>1484</width><height>10</height><texturebg colordiffuse="00FFFFFF">common/white.png</texturebg><lefttexture /><righttexture /><overlaytexture /><midtexture colordiffuse="FFE50914">common/white.png</midtexture><info>Player.Progress</info></control>
            <control type="progress"><left>96</left><bottom>179</bottom><width>1484</width><height>10</height><texturebg colordiffuse="00FFFFFF">common/white.png</texturebg><lefttexture /><righttexture /><overlaytexture /><midtexture colordiffuse="CCFFFFFF">common/white.png</midtexture><info>Player.SeekBar</info><visible>Player.Seeking</visible></control>
            <control type="label">
                <right>96</right><bottom>164</bottom><width>230</width><height>40</height>
                <align>right</align><aligny>center</aligny><font>font_main</font><textcolor>FFFFFFFF</textcolor>
                <label>$INFO[Player.TimeRemaining]</label>
                <visible>!Player.Seeking + !Player.Caching</visible>
            </control>
            <control type="label">
                <right>96</right><bottom>164</bottom><width>230</width><height>40</height>
                <align>right</align><aligny>center</aligny><font>font_main_bold</font><textcolor>FFFFFFFF</textcolor>
                <label>$INFO[Player.SeekTime]</label>
                <visible>Player.Seeking</visible>
            </control>
            <control type="label">
                <right>96</right><bottom>164</bottom><width>230</width><height>40</height>
                <align>right</align><aligny>center</aligny><font>font_main_bold</font><textcolor>FFE50914</textcolor>
                <label>$INFO[Player.CacheLevel,,%]</label>
                <visible>Player.Caching + !Player.Seeking</visible>
            </control>
        </control>

        <control type="group">
            <visible>!$EXP[Exp_InfoDialogs] + !Player.HasVideo</visible>
            <include>Animation_OSD_Fullscreen_Change</include>
                        <include>OSD_MusicSeekBar</include>
        </control>

    </controls>
</window>