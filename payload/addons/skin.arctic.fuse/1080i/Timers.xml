<?xml version="1.0" encoding="UTF-8"?>
<timers>

    <timer>
        <name>idle_spotlight_trailer</name>
        <start reset="true">[[Skin.HasSetting(Trailers.EnableAutoPlayback) + Integer.IsEqual(Window.Property(TMDBHelper.WidgetContainer),301)] | [Skin.HasSetting(Trailers.EnableAutoPlayback.Info) + Window.IsVisible(DialogVideoInfo.xml)]] + !String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.Trailer))</start>
        <reset>![[[Skin.HasSetting(Trailers.EnableAutoPlayback) + Integer.IsEqual(Window.Property(TMDBHelper.WidgetContainer),301)] | [Skin.HasSetting(Trailers.EnableAutoPlayback.Info) + Window.IsVisible(DialogVideoInfo.xml)]] + !String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.Trailer))] | !String.IsEqual(Window(Home).Property(AutoTrailer),Window(Home).Property(TMDbHelper.ListItem.Trailer)) | [Player.HasVideo + !String.IsEqual(Window(Home).Property(PlayTrailer),Player.FileNameAndPath)]</reset>
        <stop>![[[Skin.HasSetting(Trailers.EnableAutoPlayback) + Integer.IsEqual(Window.Property(TMDBHelper.WidgetContainer),301)] | [Skin.HasSetting(Trailers.EnableAutoPlayback.Info) + Window.IsVisible(DialogVideoInfo.xml)]] + !String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.Trailer))] | !String.IsEqual(Window(Home).Property(AutoTrailer),Window(Home).Property(TMDbHelper.ListItem.Trailer)) | [Player.HasVideo + !String.IsEqual(Window(Home).Property(PlayTrailer),Player.FileNameAndPath)]</stop>
        <onstart>SetProperty(AutoTrailer,$ESCINFO[Window(Home).Property(TMDbHelper.ListItem.Trailer)],Home)</onstart>
        <onstart>SetProperty(AutoTrailerTitle,$ESCINFO[Window(Home).Property(TMDbHelper.ListItem.Title)],Home)</onstart>
        <onstop condition="Player.HasVideo + String.IsEqual(Window(Home).Property(PlayTrailer),Player.FileNameAndPath) + !Window.IsVisible(1123) + [!Window.IsVisible(DialogVideoInfo.xml) | String.IsEqual(Window(Home).Property(PlayTrailerTrigger),VideoInfo)]">Action(Stop)</onstop>
        <onstop>ClearProperty(AutoTrailer,Home)</onstop>
        <onstop>ClearProperty(AutoTrailerTitle,Home)</onstop>
    </timer>

    <timer>
        <name>play_spotlight_trailer</name>
        <start reset="true">!Player.HasVideo + [[Integer.IsGreater(Skin.TimerElapsedSecs(idle_spotlight_trailer),3) + System.IdleTime(3)] | [Integer.IsGreater(Skin.TimerElapsedSecs(idle_spotlight_trailer),1) + Skin.HasSetting(Trailers.EnableAutoPlayback.Info) + Window.IsVisible(DialogVideoInfo.xml)]]</start>
        <stop>![!Player.HasVideo + [[Integer.IsGreater(Skin.TimerElapsedSecs(idle_spotlight_trailer),3) + System.IdleTime(3)] | [Integer.IsGreater(Skin.TimerElapsedSecs(idle_spotlight_trailer),1) + Skin.HasSetting(Trailers.EnableAutoPlayback.Info) + Window.IsVisible(DialogVideoInfo.xml)]]]</stop>
        <onstart condition="!String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.Trailer)) + !String.IsEqual(Window(Home).Property(PlayTrailer),Window(Home).Property(TMDbHelper.ListItem.Trailer)) + !Window.IsVisible(1120) + !Window.IsVisible(1121) + !Window.IsVisible(1122)">SetProperty(PlayTrailerTrigger,$VAR[Action_PlayTrailer_Trigger],Home)</onstart>
        <onstart condition="!String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.Trailer)) + !String.IsEqual(Window(Home).Property(PlayTrailer),Window(Home).Property(TMDbHelper.ListItem.Trailer)) + !Window.IsVisible(1120) + !Window.IsVisible(1121) + !Window.IsVisible(1122)">SetProperty(PlayTrailerTitle,$ESCINFO[Window(Home).Property(TMDbHelper.ListItem.Title)],Home)</onstart>
        <onstart condition="!String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.Trailer)) + !String.IsEqual(Window(Home).Property(PlayTrailer),Window(Home).Property(TMDbHelper.ListItem.Trailer)) + !Window.IsVisible(1120) + !Window.IsVisible(1121) + !Window.IsVisible(1122)">SetProperty(PlayTrailer,$ESCINFO[Window(Home).Property(TMDbHelper.ListItem.Trailer)],Home)</onstart>
        <onstart condition="!String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.Trailer)) + !String.IsEqual(Window(Home).Property(PlayTrailer),Window(Home).Property(TMDbHelper.ListItem.Trailer)) + !Window.IsVisible(1120) + !Window.IsVisible(1121) + !Window.IsVisible(1122)">PlayMedia($ESCINFO[Window(Home).Property(TMDbHelper.ListItem.Trailer)],1)</onstart>
    </timer>
</timers>
